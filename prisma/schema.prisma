// SkladyX — модуль «Склад» (warehouse).
// Мультитенантность с первого дня: companyId на всех доменных таблицах,
// весь доступ — через scoped() (src/lib/tenant.ts). Остатки: append-only
// StockMovement + материализованный StockBalance для партионных товаров;
// у поштучных местоположение живёт на самой единице (ItemUnit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  // Этап 5: рабочие роли РостАгро (назначаются в UserRole; рабочая роль выбирается на смене).
  RECEIVER // кладовщик-приёмка
  LOADER // кладовщик-погрузчик
  PICKER // кладовщик-сборка
  CONTROLLER // контролёр
  OBSERVER // наблюдатель (read-only)
  STOREKEEPER // legacy-кладовщик (старые процессы; не удаляем — S6 отложен)
  EMPLOYEE // legacy-сотрудник (не удаляем — S6 отложен)
}

enum TrackingType {
  LOT // партионный: материалы, учёт количеством в партии
  UNIT // поштучный: инструмент, у каждой единицы свой QR и судьба
}

enum QrType {
  LOT
  UNIT
  CELL
  EMPLOYEE
  PICKLIST
  GROUP
  ORDER // Этап 5/Пакет 6: внешний заказ (ExternalOrder)
}

enum ReceiptStatus {
  DRAFT
  POSTED
}

enum SupplierOrderStatus {
  DRAFT // таблица редактируется
  ORDERED // сохранён, позициям присвоены id (дата+номер), ждём товар
  RECEIVED // принят на склад (создана приемка)
  CANCELLED
}

enum TransferStatus {
  DRAFT
  POSTED
}

enum WriteOffStatus {
  DRAFT
  POSTED
}

// Тип документа сборки: заявка сотруднику или перемещение на склад —
// нумеруются независимо, поэтому уникальность номера в пределах типа.
enum PickListKind {
  PICK
  TRANSFER
}

enum PickListStatus {
  NEW
  PICKING
  PICKED
  STAGED
  ISSUED
  CANCELLED
}

enum IssueStatus {
  PENDING // выдано, ждёт подтверждения сотрудником
  CONFIRMED
  CANCELLED // отменена админом: товар возвращён туда, откуда был выдан
}

enum IssueSource {
  DIRECT
  PICKLIST
}

enum InventoryStatus {
  IN_PROGRESS
  REVIEW
  POSTED
  CANCELLED
}

enum UnitStatus {
  IN_STOCK
  PICKED // зарезервирована в сборке заявки
  ISSUE_PENDING // выдана, ждёт подтверждения сотрудником
  ISSUED // числится за сотрудником (будущий модуль добавит USED/RETURNED)
  WRITTEN_OFF
}

enum MovementDocType {
  RECEIPT
  CELL_ASSIGN
  TRANSFER
  WRITEOFF
  PICKLIST
  ISSUE
  ISSUE_CONFIRM
  INVENTORY
}

// ---------- Компания, пользователи, авторизация ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // { directIssueEnabled, issueConfirmationRequired, labelFormat } — zod-схема в src/lib/settings.ts
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  warehouses        Warehouse[]
  warehouseZones    WarehouseZone[]
  handlingGroups    HandlingGroup[]
  coolingSessions   CoolingSession[]
  items             Item[]
  uoms              Uom[]
  suppliers         Supplier[]
  supplierOrders    SupplierOrder[]
  receipts          Receipt[]
  transfers         Transfer[]
  writeOffs         WriteOff[]
  pickLists         PickList[]
  issues            Issue[]
  inventories       Inventory[]
  events            Event[]
  qrCodes           QrCode[]
  pushSubscriptions PushSubscription[]
  workShifts        WorkShift[]
  workflowTasks     WorkflowTask[]
}

model User {
  id            String   @id @default(cuid())
  companyId     String
  // логин — телефон (+7XXXXXXXXXX); email — legacy-вход для старых учёток
  // S3: уникальность телефона/email — per-tenant (см. @@unique ниже), не глобальная.
  phone         String?
  email         String?
  passwordHash  String? // null — пароль не задан, вход только по одноразовой ссылке
  name          String
  role          Role     @default(EMPLOYEE)
  isActive      Boolean  @default(true)
  // доступ к складам: true — все склады; иначе только перечисленные в warehouseLinks
  allWarehouses Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  authTokens     AuthToken[]
  warehouseLinks UserWarehouse[]
  userRoles      UserRole[]
  workShifts     WorkShift[]
  assignedTasks  WorkflowTask[]  @relation("userTasks")

  // S3 per-tenant identity: телефон/email уникальны в пределах организации.
  @@unique([companyId, phone])
  @@unique([companyId, email])
  @@index([companyId])
}

// Мультироли пользователя. При TENANT_AUTH=true авторизация читает свежие UserRole из БД на
// каждый защищённый запрос (S3); User.role оставлен как compatibility-поле до cleanup (S6).
// Этап 5: сюда входят рабочие роли РостАгро (RECEIVER/LOADER/PICKER/CONTROLLER/OBSERVER).
// См. docs/MULTITENANT_SECURITY_DESIGN.md.
model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// Этап 5: рабочая смена. Пользователь выбирает ОДНУ рабочую роль + склад на смену.
// История: завершённые смены не удаляем. Не более одной незавершённой смены на пользователя
// гарантируется partial unique index (endedAt IS NULL) — создаётся в миграции (Prisma не
// описывает WHERE-индексы). См. docs/ROSTAGRO_MIGRATION_DESIGN.md §2.1.
model WorkShift {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  warehouseId String
  role        Role
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  assignedTasks WorkflowTask[] @relation("shiftTasks")
  handoffsFrom  TaskHandoff[]  @relation("handoffFrom")
  handoffsTo    TaskHandoff[]  @relation("handoffTo")

  @@index([companyId])
  @@index([userId])
  @@index([warehouseId])
  @@index([role])
  @@index([endedAt])
}

// Этап 5/Пакет 2: очередь задач РостАгро. Задача не двигает остаток сама — это делают
// будущие доменные обработчики (completeWorkflowTaskInTransaction). См. ROSTAGRO_MIGRATION_DESIGN §2.2.
enum TaskPriority {
  NORMAL
  URGENT
}

enum TaskStatus {
  BLOCKED // ждёт выполнения зависимостей
  QUEUED // в очереди, не назначена
  ASSIGNED // назначена сотруднику активной смены, ещё не начата
  IN_PROGRESS // взята в работу (не более одной на пользователя — partial unique)
  HANDOFF_PENDING // ожидает принятия передачи другой сменой
  NEEDS_ATTENTION // невозможно выполнить, требует вмешательства
  COMPLETED
  CANCELLED
}

enum HandoffStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model WorkflowTask {
  id           String       @id @default(cuid())
  companyId    String
  warehouseId  String
  type         String // строковый код из src/lib/workflow-task-types.ts
  requiredRole Role
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(QUEUED)
  title        String
  description  String?
  actionUrl    String?
  subjectType  String?
  subjectId    String?
  dedupeKey    String
  loadUnits    Int          @default(1) // единиц нагрузки (>=1, CHECK в миграции)

  assignedUserId  String?
  assignedShiftId String?

  createdAt   DateTime  @default(now())
  // Этап 5/Пакет 5: отложенная задача — не назначается, пока availableAt в будущем
  // (напр. срочный забор из охлаждения к estimatedReadyAt). null — обычная задача.
  availableAt DateTime?
  // Этап 5/Пакет 6: срок исполнения (напр. arrivalAt внешнего заказа) — ключ сортировки
  // очереди: URGENT → ближайший dueAt → createdAt. null сортируется в конец (nulls last).
  dueAt       DateTime?
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  company       Company    @relation(fields: [companyId], references: [id])
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id])
  assignedUser  User?      @relation("userTasks", fields: [assignedUserId], references: [id])
  assignedShift WorkShift? @relation("shiftTasks", fields: [assignedShiftId], references: [id])

  dependencies TaskDependency[] @relation("taskDeps") // на что эта задача ссылается (зависит)
  dependents   TaskDependency[] @relation("taskDependsOn") // кто зависит от этой задачи
  handoffs     TaskHandoff[]

  @@unique([companyId, dedupeKey])
  @@index([companyId])
  @@index([warehouseId])
  @@index([status])
  @@index([status, availableAt])
  @@index([status, dueAt])
  @@index([requiredRole])
  @@index([assignedUserId])
  @@index([assignedShiftId])
}

// Зависимости задач: задача BLOCKED → QUEUED, когда все её зависимости COMPLETED.
model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  task      WorkflowTask @relation("taskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn WorkflowTask @relation("taskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

// Передача задачи между сменами (двойное подтверждение: запрос + принятие).
// Только одна активная (PENDING) передача на задачу — partial unique в миграции.
model TaskHandoff {
  id          String        @id @default(cuid())
  taskId      String
  fromShiftId String
  toShiftId   String
  status      HandoffStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  respondedAt DateTime?

  task      WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromShift WorkShift    @relation("handoffFrom", fields: [fromShiftId], references: [id])
  toShift   WorkShift    @relation("handoffTo", fields: [toShiftId], references: [id])

  @@index([taskId])
  @@index([toShiftId])
  @@index([status])
}

// Привязка пользователя к складам (когда allWarehouses = false).
model UserWarehouse {
  userId      String
  warehouseId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([warehouseId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  purpose   String // "set-password"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
}

// Журнал событий («Лента»). key — идемпотентность через upsert по [companyId, key].
model Event {
  id        String   @id @default(cuid())
  companyId String
  type      String // receipt_posted | transfer_posted | writeoff_posted | picklist_* | issue_* | inventory_* | user_* | cell_assigned ...
  key       String?
  title     String
  body      String
  url       String?
  actorId   String? // кто совершил действие
  meta      Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, type, createdAt(sort: Desc)])
}

// ---------- QR ----------

// Единая таблица QR-кодов. В QR кодируется URL {APP_URL}/q/<code>.
model QrCode {
  id        String   @id @default(cuid())
  companyId String
  code      String   @unique // 10 символов, алфавит Крокфорда (без неоднозначных знаков)
  type      QrType
  refId     String // id партии / единицы / ячейки / пользователя / заявки
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([type, refId])
  @@index([companyId])
}

// ---------- Склады, ячейки, номенклатура ----------

model Warehouse {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  address     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Этап 5/Пакет 5: скорость охлаждения R (°C/час), per-warehouse; nullable — без R>0 группа
  // > X не может уйти в охлаждение. Снимок R копируется в CoolingSession при старте.
  coolingRate Decimal? @db.Decimal(6, 2)
  createdAt   DateTime @default(now())

  company         Company          @relation(fields: [companyId], references: [id])
  cells           Cell[]
  zones           WarehouseZone[]
  handlingGroups  HandlingGroup[]
  coolingSessions CoolingSession[]
  userLinks       UserWarehouse[]
  workShifts      WorkShift[]
  workflowTasks   WorkflowTask[]

  @@index([companyId])
}

// Этап 5/Пакет 3: гибрид зон. Системный ZoneKind (стабильная логика) + настраиваемые
// зоны организации (code/name). Виртуальные зоны (RECEIVING/CONTROL/DISCREPANCY) —
// «одна большая ячейка», без физических Cell. Физические (STORAGE/COOLING/ISSUE/BUFFER)
// содержат ячейки. BUFFER — физическая ячейка, а не виртуальная зона.
enum ZoneKind {
  RECEIVING
  STORAGE
  COOLING
  CONTROL
  ISSUE
  DISCREPANCY
  BUFFER
}

model WarehouseZone {
  id          String   @id @default(cuid())
  companyId   String
  warehouseId String
  code        String
  name        String
  kind        ZoneKind
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  cells     Cell[]

  @@unique([warehouseId, code])
  @@index([companyId])
  @@index([warehouseId])
  @@index([kind])
}

model Cell {
  id          String  @id @default(cuid())
  companyId   String
  warehouseId String
  code        String // "А-01-02"
  // Пакет 3: зона + уровень. zoneId/level nullable на период миграции; для новых
  // физических ячеек зона обязательна (проверка в actions), у STORAGE — уровень >= 1.
  // isStaging пока не удаляем: синхронизируется с зоной ISSUE (обратная совместимость).
  zoneId      String?
  level       Int? // уровень стеллажа: 1 — нижний; для STORAGE обязателен
  isStaging   Boolean @default(false) // ячейка зоны выдачи собранных заявок (= зона ISSUE)
  isActive    Boolean @default(true)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  zone      WarehouseZone? @relation(fields: [zoneId], references: [id])

  @@unique([warehouseId, code])
  @@index([companyId])
  @@index([zoneId])
}

// Этап 5/Пакет 4: неделимая группа/паллета приёмки. Фактическое местоположение — из
// StockBalance/ledger (locKey Z:<receivingZone> → C:<cell>), СВОЕГО cellId нет (нет второго
// источника истины). Приёмка поддерживает TrackingType=LOT (для UNIT — ошибка в actions).
enum HandlingGroupStatus {
  IN_RECEIVING // принята в виртуальную зону RECEIVING
  AWAITING_STORAGE // temperature <= X — ждёт размещения в STORAGE
  AWAITING_COOLING // temperature > X — ждёт размещения в COOLING
  IN_STORAGE
  IN_COOLING
}

model HandlingGroup {
  id           String              @id @default(cuid())
  companyId    String
  warehouseId  String
  itemId       String
  lotId        String // связь с партией (приход этой группы)
  qty          Decimal             @db.Decimal(14, 3) // принятое количество (целое штук)
  temperature  Decimal             @db.Decimal(6, 2) // исходная температура, °C
  thresholdX   Decimal             @db.Decimal(6, 2) // снимок порога X на момент приёмки
  status       HandlingGroupStatus @default(IN_RECEIVING)
  dedupeKey    String
  acceptedById String
  acceptedAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  coolingSession CoolingSession?

  @@unique([companyId, dedupeKey])
  @@index([companyId, status])
  @@index([warehouseId])
  @@index([lotId])
}

// Этап 5/Пакет 5: сессия охлаждения группы > X. Снимки X (порог) и R (скорость) фиксируются
// в момент старта, чтобы смена настроек не переписала начатый процесс. Фактическое
// местоположение группы — из ledger; сессия хранит рабочую ячейку охлаждения и срок готовности.
enum CoolingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CellReservationStatus {
  ACTIVE
  RELEASED
}

model CoolingSession {
  id              String        @id @default(cuid())
  companyId       String
  warehouseId     String
  handlingGroupId String        @unique // одна активная сессия на группу
  coolingCellId   String // ячейка COOLING, где физически охлаждается группа
  startTemp       Decimal       @db.Decimal(6, 2)
  thresholdX      Decimal       @db.Decimal(6, 2) // снимок X
  coolingRate     Decimal       @db.Decimal(6, 2) // снимок R (°C/час)
  startedAt       DateTime      @default(now())
  estimatedReadyAt DateTime // startedAt + (startTemp - X)/R; пересчитывается при повторном замере
  status          CoolingStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company      Company                @relation(fields: [companyId], references: [id])
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id])
  group        HandlingGroup          @relation(fields: [handlingGroupId], references: [id])
  measurements TemperatureMeasurement[]
  reservations CellReservation[]

  @@index([companyId, status])
  @@index([warehouseId])
}

model TemperatureMeasurement {
  id         String   @id @default(cuid())
  companyId  String
  sessionId  String
  temperature Decimal @db.Decimal(6, 2)
  measuredAt DateTime @default(now())
  byUserId   String

  session CoolingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Активная бронь ячейки под охлаждение (резерв STORAGE-ячейки ур. 3+). Остаток НЕ двигает.
// Одна активная бронь на ячейку — partial unique в миграции. Старые операции и прямое
// размещение не должны использовать активно зарезервированную ячейку.
model CellReservation {
  id          String                @id @default(cuid())
  companyId   String
  warehouseId String
  cellId      String
  sessionId   String?
  // Этап 5/Пакет 6: бронь ячейки под перестановку группы (§2.6 «резерв под задачу/группу»).
  // Заполняется при цепочке погрузчика ур.3+→ур.1-2: ячейка забронирована принять эту группу.
  // sessionId — бронь под охлаждение; handlingGroupId — бронь под перестановку. Взаимоисключимы.
  handlingGroupId String?
  status      CellReservationStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())
  releasedAt  DateTime?

  session CoolingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([cellId])
  @@index([sessionId])
  @@index([handlingGroupId])
}

model Uom {
  id            String  @id @default(cuid())
  companyId     String
  name          String // шт, м, кг, м², м³, упак, л
  allowFraction Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])
  items   Item[]

  @@unique([companyId, name])
}

model Item {
  id        String       @id @default(cuid())
  companyId String
  name      String
  sku       String?
  uomId     String
  tracking  TrackingType
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id])
  uom     Uom     @relation(fields: [uomId], references: [id])

  @@unique([companyId, sku])
  @@index([companyId, name])
}

// Сквозные номера документов в рамках компании.
model Counter {
  companyId String
  docType   String
  value     Int    @default(0)

  @@id([companyId, docType])
}

// ---------- Поставщики и заказы поставщикам ----------

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id])
  orders  SupplierOrder[]

  @@unique([companyId, name])
  @@index([companyId])
}

model SupplierOrder {
  id          String              @id @default(cuid())
  companyId   String
  number      Int
  supplierId  String
  warehouseId String
  status      SupplierOrderStatus @default(DRAFT)
  receiptId   String?             @unique // приемка, созданная кнопкой «Принять на склад»
  note        String?
  createdById String
  createdAt   DateTime            @default(now())
  orderedAt   DateTime?
  receivedAt  DateTime?

  company  Company             @relation(fields: [companyId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    SupplierOrderLine[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt(sort: Desc)])
}

model SupplierOrderLine {
  id          String   @id @default(cuid())
  companyId   String
  orderId     String
  itemId      String
  qty         Decimal  @db.Decimal(14, 3)
  price       Decimal? @db.Decimal(14, 2)
  // id позиции «дата-№заказа-№строки» (6072026-12-1): номера заказов монотонные и не
  // переиспользуются, поэтому id не задваивается ни при каких условиях (в т.ч. удалении).
  // Присваивается при сохранении заказа, при приёмке становится QR-кодом партии;
  // у поштучных единиц — с суффиксом (6072026-12-1-2).
  lineCode    String?  @unique
  // принятое количество (приемка идёт сканированием позиция за позицией)
  receivedQty Decimal  @default(0) @db.Decimal(14, 3)
  createdAt   DateTime @default(now())

  order SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------- Приемка ----------

model Receipt {
  id          String        @id @default(cuid())
  companyId   String
  number      Int
  warehouseId String
  status      ReceiptStatus @default(DRAFT)
  postedAt    DateTime?
  supplier    String?
  note        String?
  createdById String
  createdAt   DateTime      @default(now())

  company Company       @relation(fields: [companyId], references: [id])
  lines   ReceiptLine[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt(sort: Desc)])
}

model ReceiptLine {
  id          String   @id @default(cuid())
  companyId   String
  receiptId   String
  itemId      String
  qty         Decimal  @db.Decimal(14, 3)
  price       Decimal? @db.Decimal(14, 2) // закупочная за единицу
  cellId      String? // куда положили при приемке (можно назначить позже сканом)
  orderLineId String?  @unique // позиция заказа поставщику (приемка сканированием)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

// Партия = позиция приемки партионного товара.
model Lot {
  id            String   @id @default(cuid())
  companyId     String
  itemId        String
  receiptLineId String   @unique
  qtyReceived   Decimal  @db.Decimal(14, 3)
  price         Decimal? @db.Decimal(14, 2) // снимок из позиции — основа стоимостной оценки
  createdAt     DateTime @default(now())

  @@index([companyId, itemId])
}

// Единица поштучного товара — сама себе остаток (местоположение и статус на ней).
model ItemUnit {
  id            String     @id @default(cuid())
  companyId     String
  itemId        String
  receiptLineId String
  serial        Int // № в позиции приемки
  price         Decimal?   @db.Decimal(14, 2)
  status        UnitStatus @default(IN_STOCK)
  warehouseId   String?
  cellId        String?
  employeeId    String?
  pickListId    String? // резерв в сборке заявки
  issueId       String?
  createdAt     DateTime   @default(now())

  @@index([companyId, itemId, status])
  @@index([companyId, employeeId])
  @@index([companyId, cellId])
  @@index([pickListId])
  @@index([receiptLineId])
}

// ---------- Остатки ----------

// Материализованные остатки ПАРТИОННЫХ товаров.
// locKey: "C:<cellId>" | "W:<warehouseId>" (без ячейки) | "E:<userId>" (за сотрудником)
//         | "EP:<userId>" (выдано, ждёт подтверждения). Будущие модули: "S:<siteId>" и т.д.
model StockBalance {
  id          String  @id @default(cuid())
  companyId   String
  itemId      String
  lotId       String
  locKey      String
  warehouseId String? // денормализация для выборок
  cellId      String?
  zoneId      String? // Пакет 4: виртуальная зона (locKey Z:<zoneId>), напр. RECEIVING
  employeeId  String?
  qty         Decimal @db.Decimal(14, 3)

  @@unique([lotId, locKey])
  @@index([companyId, itemId])
  @@index([companyId, warehouseId, cellId])
  @@index([companyId, employeeId])
  @@index([companyId, zoneId])
}

// Append-only журнал движений. Пустая сторона = «внешний мир» (приемка/списание).
model StockMovement {
  id              String          @id @default(cuid())
  companyId       String
  docType         MovementDocType
  docId           String
  itemId          String
  lotId           String?
  unitId          String?
  qty             Decimal         @db.Decimal(14, 3)
  fromWarehouseId String?
  fromCellId      String?
  fromZoneId      String? // Пакет 4: виртуальная зона-источник (Z:<zoneId>)
  fromEmployeeId  String?
  fromPending     Boolean         @default(false) // сторона "EP:" — ждёт подтверждения
  toWarehouseId   String?
  toCellId        String?
  toZoneId        String? // Пакет 4: виртуальная зона-назначение (Z:<zoneId>)
  toEmployeeId    String?
  toPending       Boolean         @default(false)
  createdById     String
  createdAt       DateTime        @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, itemId])
  @@index([lotId])
  @@index([unitId])
  @@index([docType, docId])
}

// ---------- Файлы ----------

model Attachment {
  id           String   @id @default(cuid())
  companyId    String
  ownerType    String // "receipt" | "receipt_line" | будущие
  ownerId      String
  fileName     String
  mime         String
  size         Int
  storedPath   String
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([companyId])
}

// ---------- Перемещение ----------

model Transfer {
  id              String         @id @default(cuid())
  companyId       String
  number          Int
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(DRAFT)
  postedAt        DateTime?
  createdById     String
  createdAt       DateTime       @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  lines   TransferLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model TransferLine {
  id         String  @id @default(cuid())
  companyId  String
  transferId String
  itemId     String
  lotId      String?
  unitId     String?
  qty        Decimal @db.Decimal(14, 3)
  toCellId   String?

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

// ---------- Списание ----------

model WriteOff {
  id          String         @id @default(cuid())
  companyId   String
  number      Int
  warehouseId String? // списание со склада...
  employeeId  String? // ...или с сотрудника (будущее «использование»)
  reason      String // причина обязательна
  status      WriteOffStatus @default(DRAFT)
  postedAt    DateTime?
  createdById String
  createdAt   DateTime       @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  lines   WriteOffLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model WriteOffLine {
  id         String  @id @default(cuid())
  companyId  String
  writeOffId String
  itemId     String
  lotId      String?
  unitId     String?
  qty        Decimal @db.Decimal(14, 3)

  writeOff WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)

  @@index([writeOffId])
}

// ---------- Заявка на сбор ----------

// Заявка на сбор (targetEmployeeId) ИЛИ перемещение на склад (targetWarehouseId):
// одинаковый жизненный цикл и сканирование, заполнено ровно одно из полей.
model PickList {
  id                String         @id @default(cuid())
  companyId         String
  kind              PickListKind   @default(PICK)
  number            Int
  warehouseId       String? // склад, с которого собирают (обязателен на уровне приложения)
  targetEmployeeId  String? // кому выдать (заявка на сбор)
  targetWarehouseId String? // на какой склад переместить (перемещение)
  status            PickListStatus @default(NEW)
  stagingCellId     String? // текущая ячейка выдачи при сборке (последняя назначенная)
  note              String?
  createdById       String
  pickedById        String?
  createdAt         DateTime       @default(now())
  savedAt           DateTime? // документ сохранён админом: виден кладовщикам, ушёл пуш
  pickedAt          DateTime?
  stagedAt          DateTime?
  issuedAt          DateTime?

  company Company        @relation(fields: [companyId], references: [id])
  lines   PickLine[]
  cells   PickListCell[]

  @@unique([companyId, kind, number])
  @@index([companyId, status])
}

model PickLine {
  id           String  @id @default(cuid())
  companyId    String
  pickListId   String
  itemId       String
  // конкретный остаток, выбранный при создании: партия в ячейке или единица
  lotId        String?
  unitId       String?
  cellId       String?
  qtyRequested Decimal @db.Decimal(14, 3)
  qtyPicked    Decimal @default(0) @db.Decimal(14, 3)

  pickList     PickList          @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  fulfillments PickFulfillment[]

  @@index([pickListId])
}

// Чем именно закрыта позиция заявки (скан за сканом).
model PickFulfillment {
  id              String   @id @default(cuid())
  companyId       String
  pickLineId      String
  lotId           String?
  unitId          String?
  qty             Decimal  @db.Decimal(14, 3)
  fromWarehouseId String
  fromCellId      String?
  toCellId        String? // ячейка зоны выдачи, куда переместили при сборке
  scannedById     String
  createdAt       DateTime @default(now())

  pickLine PickLine @relation(fields: [pickLineId], references: [id], onDelete: Cascade)

  @@index([pickLineId])
}

// Ячейки зоны выдачи, назначенные заявке при сборке. Текущая (куда идут сканы)
// хранится в PickList.stagingCellId; заменить её можно, пока в неё ничего не положено.
model PickListCell {
  id         String   @id @default(cuid())
  companyId  String
  pickListId String
  cellId     String
  createdAt  DateTime @default(now())

  pickList PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)

  @@unique([pickListId, cellId])
  @@index([pickListId])
}

// ---------- Выдача сотруднику ----------

model Issue {
  id          String      @id @default(cuid())
  companyId   String
  number      Int
  employeeId  String
  source      IssueSource
  pickListId  String?     @unique
  status      IssueStatus
  issuedById  String
  issuedAt    DateTime    @default(now())
  confirmedAt DateTime?

  company Company     @relation(fields: [companyId], references: [id])
  lines   IssueLine[]

  @@unique([companyId, number])
  @@index([companyId, employeeId])
  @@index([companyId, status])
}

model IssueLine {
  id        String   @id @default(cuid())
  companyId String
  issueId   String
  itemId    String
  lotId     String?
  unitId    String?
  qty       Decimal  @db.Decimal(14, 3)
  price     Decimal? @db.Decimal(14, 2) // снимок для стоимостной оценки

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// ---------- Инвентаризация ----------

model Inventory {
  id          String          @id @default(cuid())
  companyId   String
  number      Int
  warehouseId String
  status      InventoryStatus @default(IN_PROGRESS)
  postedAt    DateTime?
  createdById String
  createdAt   DateTime        @default(now())

  company Company         @relation(fields: [companyId], references: [id])
  lines   InventoryLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model InventoryLine {
  id          String   @id @default(cuid())
  companyId   String
  inventoryId String
  cellId      String?
  itemId      String
  lotId       String?
  unitId      String?
  expectedQty Decimal  @db.Decimal(14, 3)
  countedQty  Decimal? @db.Decimal(14, 3) // null — ещё не считали

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
}

// ---------- Этап 5/Пакет 6: внешние заказы, резерв и сборка ----------

// ExternalOrder — КАНОНИЧЕСКИЙ владелец жизненного цикла заказа (дизайн §1.6/§2.4). Легаси
// PickList НЕ переиспользуется (у него свой жизненный цикл выдачи сотруднику) — исполнение
// ведут StockReservation + WorkflowTask(PICK_ORDER), чтобы не было двух конкурирующих машин.
enum ExternalOrderStatus {
  IMPORTED // импортирован (идемпотентно по externalId)
  PARTIALLY_RESERVED // зарезервирована часть строк (FIFO), задача сборщику НЕ создаётся
  READY_TO_PICK // полное покрытие; PICK_ORDER создан (возможно BLOCKED цепочкой перестановки)
  PICKING // сборщик взял задачу
  IN_CONTROL // сборка завершена, товар в зоне CONTROL (задача контроля — Пакет 7)
  BLOCKED // полное покрытие, но нет безопасной цепочки перестановки/места — без невыполнимой задачи
}

// Резерв товара на ТОЧНЫЙ источник (дизайн §1.7/§2.7). Остаток НЕ двигает (это бронь);
// движение — при отборе через ядро. lotId-уникальность ЗАПРЕЩЕНА (один lot — частями в
// разные заказы); корректность даёт блокировка строки-источника + Σ active ≤ balance.
enum StockReservationStatus {
  ACTIVE
  FULFILLED // товар отобран (движение через ядро)
  RELEASED // отменён/ошибка/переназначение
}

model ExternalOrder {
  id          String              @id @default(cuid())
  companyId   String
  warehouseId String
  externalId  String // идентификатор во внешней системе — источник идемпотентности импорта
  status      ExternalOrderStatus @default(IMPORTED)
  arrivalAt   DateTime? // срок/ожидаемое время — ключ сортировки очереди (dueAt задачи)
  payloadHash String // снимок нормализованного payload; изменённый payload → контролируемая ошибка
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lines        ExternalOrderLine[]
  reservations StockReservation[]

  @@unique([companyId, externalId]) // идемпотентность импорта (дизайн §3)
  @@index([companyId, status])
  @@index([warehouseId])
}

model ExternalOrderLine {
  id             String  @id @default(cuid())
  companyId      String
  orderId        String
  externalLineId String // идентификатор строки во внешней системе
  itemId         String
  requiredQty    Decimal @db.Decimal(14, 3)
  reservedQty    Decimal @default(0) @db.Decimal(14, 3)
  pickedQty      Decimal @default(0) @db.Decimal(14, 3)

  order        ExternalOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservations StockReservation[]

  @@unique([orderId, externalLineId])
  @@index([companyId])
  @@index([orderId])
  @@index([itemId])
}

model StockReservation {
  id              String                 @id @default(cuid())
  companyId       String
  orderId         String
  lineId          String
  taskId          String? // задача сборки/перестановки (для аудита)
  handlingGroupId String? // какая паллета
  lotId           String? // партия-источник (FIFO по Lot.createdAt)
  sourceLocKey    String? // точная строка баланса-источника: "C:<cellId>"
  cellId          String? // денормализация источника (для UI/цепочки)
  unitId          String? // для поштучных (TrackingType=UNIT)
  qty             Decimal                @db.Decimal(14, 3)
  status          StockReservationStatus @default(ACTIVE)
  dedupeKey       String // идемпотентность создания резерва
  createdAt       DateTime               @default(now())
  releasedAt      DateTime?
  fulfilledAt     DateTime?

  order ExternalOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line  ExternalOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([companyId, dedupeKey])
  @@index([companyId, status])
  @@index([lotId, sourceLocKey]) // Σ active(lotId, locKey) — проверка суммы резервов на строке
  @@index([orderId])
  @@index([lineId])
  @@index([handlingGroupId])
}
