# База данных.
# Локально (docker-compose.dev.yml): postgres на 127.0.0.1:5435.
DATABASE_URL=postgresql://skladyx:skladyx@localhost:5435/skladyx

# Пароль БД для прод-compose (docker-compose.yml подставляет его в DATABASE_URL и POSTGRES_PASSWORD).
DB_PASSWORD=

# Секрет подписи JWT-сессий (openssl rand -hex 32). Свой, не из других проектов.
AUTH_SECRET=

# Публичный адрес приложения (для QR-кодов и ссылок установки пароля).
APP_URL=https://rostagro.skladyx.ru

# Дефолтный org-slug — ТОЛЬКО для development (localhost). В production при TENANT_AUTH=true
# неизвестный/голый/некорректный host закрывается (fail-closed), этот дефолт не применяется.
DEFAULT_ORG_SLUG=rostagro

# Этап 4B/S2 dual-read ролей (серверный флаг, НЕ NEXT_PUBLIC).
# false — права только по legacy User.role (поведение до S2, по умолчанию);
# true  — права по набору ролей из UserRole (fallback на User.role). Откат — вернуть false.
ROLES_DUAL_READ=false

# Этап 4B/S3 tenant-auth (серверный флаг, НЕ NEXT_PUBLIC).
# false — совместимое старое поведение (вход без host→company, права из JWT);
# true  — строгая tenant-авторизация: вход через поддомен, host==session.companyId,
#         свежие isActive/UserRole из БД на каждый запрос. При TENANT_AUTH=true роли всегда
#         берутся из свежего UserRole независимо от ROLES_DUAL_READ. Откат — вернуть false
#         (запрещён после появления второго реального tenant — тогда только fix-forward/restore).
TENANT_AUTH=false
# Базовый домен SaaS: <org>.<TENANT_BASE_DOMAIN>.
TENANT_BASE_DOMAIN=skladyx.ru
# Префикс поддомена контура: '' в prod; 'staging-' на staging (staging-<org>.<base> → <org>).
HOST_ORG_PREFIX=

# Этап 5/Пакет 2: очередь задач (серверный флаг). false — пункт меню «Задачи» скрыт и
# действия очереди запрещены. На staging включается true; prod пока false.
WORKFLOW_TASKS_ENABLED=false

# Этап 5/Пакет 3: зоны и уровни ячеек (серверный флаг). false — карточка склада в прежнем
# режиме (плоский список ячеек + «зона выдачи»). На staging включается true; prod пока false.
WAREHOUSE_ZONES_ENABLED=false

# Этап 5/Пакет 4: групповая приёмка + температурный контроль (серверный флаг). false — экран
# приёмки группами скрыт, action запрещён. Требует настроенный порог X. На staging true; prod false.
GROUP_RECEIVING_ENABLED=false

# Этап 5/Пакет 5: охлаждение и срочный забор (серверный флаг). false — группа > X кладётся в
# COOLING без сессии охлаждения (как в Пакете 4). Требует настроенный R>0 у склада. На staging true; prod false.
COOLING_WORKFLOW_ENABLED=false

# Web-push VAPID (npx web-push generate-vapid-keys). Свои ключи.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@skladyx.ru

# Каталог загрузки файлов (сертификаты, накладные).
UPLOAD_DIR=./uploads

# Первичный seed (создаётся организация и админ; пароль печатается в консоль, если не задан).
SEED_COMPANY_NAME=РостАгро
SEED_COMPANY_SLUG=rostagro
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=
